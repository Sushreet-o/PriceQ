@using PriceQ.Models
@using Microsoft.AspNetCore.Identity
@using PriceQ.Data
@model IEnumerable<Product>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "PriceQ Nepal - Find the Best Price";

    // Logic to fetch the First Name if the user is logged in
    string welcomeMessage = "";
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null && !string.IsNullOrEmpty(user.FirstName))
        {
            welcomeMessage = $"Welcome, {user.FirstName}!";
        }
    }
}

<div class="homepage-wrapper">

    <section class="hero container">
        <div class="row align-items-center">
            <div class="col-md-7 text-section">
                
                @if (!string.IsNullOrEmpty(welcomeMessage))
                {
                    <!-- Circled in blue: Welcome Message for logged-in users -->
                    <h2 class="fw-bold mb-3" style="color: #3e288e; font-size: 1.6rem; animation: fadeIn 0.8s ease;">
                        @welcomeMessage
                    </h2>
                }

                <h1>Find the best price. <br /><span class="purple-text">Every time.</span></h1>
                <p>Compare prices from Nepal’s most trusted stores and choose the best deal for you.</p>
                
                <!-- FIXED: Wrapped in a form so the button actually works -->
                <form asp-controller="Home" asp-action="Search" method="get">
                    <div class="search-bar-wrapper mt-4">
                        <i class="fas fa-search ms-3 text-muted"></i>
                        <!-- FIXED: Added name="query" -->
                        <input type="search" name="query" placeholder="Search for products, brands and more...">
                        <button type="submit" class="search-btn">Search</button>
                    </div>
                </form>
                
                <div class="popular-searches mt-3">
                    <span class="label">Popular searches:</span>
                    <!-- Tip: You can update these links to actually search too -->
                    <a asp-action="Search" asp-route-query="iPhone 15" class="search-tag">iPhone 15</a>
                    <a asp-action="Search" asp-route-query="Nike Air Force 1" class="search-tag">Nike Air Force 1</a>
                    <a asp-action="Search" asp-route-query="MacBook Air M2" class="search-tag">MacBook Air M2</a>
                </div>
            </div>

            <div class="col-md-5">
                <div class="hero-design-container">
                    <div class="hero-circle-bg"></div>
                    <div class="hero-dots-bg"></div>

                    <div class="featured-nike-card">
                        <div class="heart-btn">
                            <i class="far fa-heart"></i>
                        </div>
            
                        <img src="/images/nike_af1.png.png" alt="Nike Air Force 1">
            
                        <div class="card-body p-0">
                            <h5 class="fw-bold mb-0">Nike Air Force 1</h5>
                            <p class="text-muted small">Men's Shoes</p>
                
                            <div class="d-flex justify-content-between align-items-end mt-4">
                                <div>
                                    <span class="text-muted small d-block">From</span>
                                    <span class="fw-bold fs-4" style="color: #3e288e;">Rs. 12,299</span>
                                </div>
                                <div class="best-price-pill">
                                    Best Price
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The rest of your code (Categories, Deals, Trust Banner) remains exactly as you have it -->
    <section class="categories container mt-5 pt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Top Categories</h2>
            <a href="#" class="view-all-link">View all</a>
        </div>
        
        <div class="categories-grid">
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-laptop"></i></div>
                <span>Electronics</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-tshirt"></i></div>
                <span>Fashion</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-shoe-prints"></i></div>
                <span>Footwear</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-couch"></i></div>
                <span>Home & Living</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-magic"></i></div>
                <span>Beauty</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-headphones"></i></div>
                <span>Accessories</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-basketball-ball"></i></div>
                <span>Sports</span>
            </a>
            <a href="#" class="category-card">
                <div class="icon-box"><i class="fas fa-book"></i></div>
                <span>Books & More</span>
            </a>
        </div>
    </section>

    <section class="top-deals-today container mt-5 pt-5">
        <div class="deals-header mb-4 d-flex justify-content-between align-items-center">
            <h2 class="section-title mb-0">Top Deals Today</h2>
            <a href="#" class="view-all-link" style="color: purple; font-size:0.85rem;">View all deals</a>
        </div>

        <div class="row">
            @if (ViewBag.TodayDealsList != null)
            {
                @foreach (var item in ViewBag.TodayDealsList as List<Product>)
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="deal-card shadow-sm bg-white p-3" style="border-radius:15px; min-height: 220px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div class="text-center mb-2">
                                <img src="@item.ImageUrl" alt="@item.Name" style="max-height:100px; object-fit:contain;">
                            </div>
                            <div>
                                <h6 class="fw-bold" style="font-size:0.9rem; line-height:1.3;">@item.Name</h6>
                                <p class="mb-1 text-muted" style="font-size:0.8rem;">From <br><span class="fw-bold text-primary" style="font-size:1.1rem;">@item.CurrentPrice</span></p>
                                <div class="seller-line d-flex align-items-center border-top mt-2 pt-2">
                                    <img src="@item.StoreLogoUrl" alt="Seller" style="max-height:30px;">
                                    <span class="ms-2 text-muted" style="font-size:0.7rem;">@item.StoreName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="text-center mt-5 mb-5">
            <a asp-controller="Home" asp-action="Deals" class="btn text-white fw-bold"
                   style="background-color: #3e288e; border-radius: 12px; padding: 12px 60px; font-size: 1.1rem; transition: background 0.3s ease;">
                View All Deals
            </a>
        </div>
    </section>

    <section class="top-deals-refined container mt-5 pt-5">
        <div class="deals-header mb-4">
            <h2 class="section-title">Top Deals</h2>
            <p class="section-subtitle">Grab the best deals from top stores.</p>
        </div>

        <div class="deals-filter-grid mb-4">
            <a href="#" class="filter-card active">All</a>
            <a href="#" class="filter-card">Electronics</a>
            <a href="#" class="filter-card">Fashion</a>
            <a href="#" class="filter-card">Footwear</a>
            <a href="#" class="filter-card">Home & Living</a>
            <a href="#" class="filter-card">More</a>
        </div>

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="deal-card-refined shadow-sm bg-white p-4" style="border-radius:15px; border: 1px solid #f0f0f0;">
                        <div class="card-image-container text-center mb-3" style="height:150px; display:flex; align-items:center; justify-content:center;">
                            <img src="@item.ImageUrl" alt="@item.Name" style="max-height:100%; max-width:100%; object-fit:contain;">
                        </div>
                        <div class="deal-content">
                            <h6 class="product-name fw-semibold mb-2">@item.Name</h6>
                            <div class="price-box mb-3">
                                <span class="current-price fw-bold text-primary" style="font-size:1.2rem;">@item.CurrentPrice</span>
                                <span class="previous-price text-decoration-line-through text-muted ms-2" style="font-size:0.9rem;">@item.PreviousPrice</span>
                            </div>
                            <div class="seller-line mt-3 d-flex align-items-center pt-3 border-top">
                                <img src="@item.StoreLogoUrl" alt="Store" style="height:30px;">
                                <span class="store-name ms-2 text-muted" style="font-size:0.8rem;">@item.StoreName</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="trust-banner py-5 bg-white border-top">
        <div class="container text-center">
            <p class="text-muted">Trusted by thousands of smart shoppers</p>
            <div class="d-flex justify-content-center align-items-center gap-5 flex-wrap mt-4">
                <img src="/images/logos/daraz_logo.svg.png" style="height: 25px; opacity: 0.6;">
                <img src="/images/logos/alibaba_logo.svg.png" style="height: 45px; opacity: 0.6;">
                <img src="/images/logos/hamrobazar_logo.svg.png" style="height: 30px; opacity: 0.6;">
                <img src="/images/logos/flipkart_logo.svg.png" style="height: 30px; opacity: 0.6;">
                <img src="/images/logos/amazon_logo.svg.png" style="height: 30px; opacity: 0.6;">
                <img src="/images/logos/sastodeal_logo.svg.png" style="height: 30px; opacity: 0.6;">
               

            </div>
        </div>
    </section>
</div>