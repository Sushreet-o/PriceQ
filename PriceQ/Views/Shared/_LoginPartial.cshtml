@using Microsoft.AspNetCore.Identity
@using PriceQ.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">

    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser?.FirstName ?? User.Identity?.Name;

        <li class="nav-item">
            <a class="nav-link text-dark me-3 fw-bold"
                   asp-controller="Home"
                   asp-action="Profile"
                   title="My Profile"
                   style="font-size: 0.9rem; text-decoration: none;">

                <i class="bi bi-person-circle me-1"></i>
                Profile
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">

                <button type="submit"
                        class="nav-link btn btn-link text-dark p-0 border-0"
                        style="font-size: 0.9rem; text-decoration: none;">

                    Logout

                </button>

            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark me-3"
                   asp-area="Identity"
                   asp-page="/Account/Login"
                   style="font-size: 0.9rem; font-weight: 500;">

                Login

            </a>
        </li>

        <li class="nav-item">
            <a class="btn btn-dark px-4 py-2"
                   asp-area="Identity"
                   asp-page="/Account/Register"
                   style="border-radius: 8px; font-weight: 600; font-size: 0.9rem;">

                Sign Up

            </a>
        </li>
    }

</ul>